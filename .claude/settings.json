{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Agent",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(node --test*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "Bash(git blame*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(wc *)",
      "Bash(ls*)",
      "Bash(python tools/regen_golden_master.py measure*)",
      "Bash(python tools/regen_golden_master.py origin*)",
      "Bash(python tools/regen_golden_master.py verify-endpoint*)"
    ],
    "ask": [
      "Bash(python tools/regen_golden_master.py regen*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/pre_push_fast_gates.py",
            "timeout": 600,
            "statusMessage": "Running fast-gates before push..."
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/large_file_guard.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking file size..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/post_edit_text_hygiene.py",
            "timeout": 15,
            "statusMessage": "Checking text hygiene..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/sync_main.ps1",
            "timeout": 30,
            "statusMessage": "Syncing main from origin..."
          }
        ]
      }
    ]
  }
}
