# Build / generated artifacts (regenerable; do not version)
dist/
build/
__pycache__/
*.pyc
.pytest_cache/

# output/js, output/css, output/index.html are a byte-for-byte copy of
# frontend/ written by src/dashboard_ui/builder.py:write_dashboard_ui for
# offline workbook bundles. They drifted from frontend/ while committed
# (nothing regenerated them automatically) — keep them generated-only.
output/js/
output/css/
output/index.html

# Local runtime state and recovery/backup copies
local_state/
_recovery_local_state_*/
saved_plans/
*.rpx
*.db
*.db-wal
*.db-shm

# financial_trends_reporter's own runtime log: real net worth, cashflow, and
# spending-by-category figures for every logged day -- same PII sensitivity
# class as input/, so it stays untracked for the same reason (see below).
financial_trends_reporter/data/*.jsonl

# Real plan data: a household's actual name, DOB, retirement date, SSA
# benefit amounts, insurance premiums, and every other personal/financial
# fact the app captures. Historically tracked, which put real client PII on
# a path into git history the moment someone entered it and saved.
# local_state/*.db is already the canonical store (see config_backend.py's
# DB-canonical migration); these CSV/JSON/YAML files are a materialized
# mirror the app writes for tooling/offline use, not the source of truth, so
# nothing is lost by leaving them untracked. input/demo/ is deliberately
# fictional demo content and stays tracked, as does ytd_transactions_sample.csv
# (a generic template with no real transactions) and the two README files.
/input/*
!/input/demo/
!/input/README_INPUT_PACKAGE.md
!/input/README_YTD_INPUTS.md
!/input/ytd_transactions_sample.csv

# Monarch Extractor (ticket 305): only monarch_extract.py and run_monarch.ps1
# are source. Everything else it creates at runtime is either a live browser
# credential store or real transaction data, neither of which belongs in git.
Monarch Extractor/monarch-browser/
Monarch Extractor/.venv/
Monarch Extractor/output/
Monarch Extractor/raw/

# Logs / scratch
*.log
build_log.txt
build_exit.txt

# Transient output from an external "phase3" beautify/auto-fix codemod that
# runs outside the repo (not produced by the committed test suite). Ignore so
# it does not dirty `git status` between runs.
phase3_failures.json
phase3_failures.txt
phase3_fixes.json
scratch_p3.xml

node_modules/
.env
dist/
build/
.DS_Store
*.log
.vscode/

# Claude Code agent worktrees (transient, harness-managed; auto-cleaned)
.claude/worktrees/

# Python tooling
.ruff_cache/
.coverage
*.egg-info/
dist-info/

# IDE
.idea/
*.swp
*.swo

# Generated artifacts
output/
coverage.xml

# Playwright E2E (tests/e2e/) run artifacts
/test-results/
/playwright-report/
/playwright/.cache/

# Microsoft Office lock/autorecovery temp files (created while a doc is open)
~$*.doc
~$*.docx
~$*.xls
~$*.xlsx
~$*.ppt
~$*.pptx
~WRL*.tmp
