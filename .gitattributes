# The Plan Data CSV fixtures are hashed and parsed byte-for-byte by tests (the golden
# baseline, the importer). Without an explicit policy, Git's core.autocrlf converts
# LF -> CRLF on checkout on Windows, changing every byte count and SHA256 versus a
# checkout on Linux/Mac. Force LF everywhere so the checked-out bytes are identical
# across platforms and CI runners.
*.csv text eol=lf

# .claude/workflows/*.js scripts are passed verbatim to the Workflow tool's
# permission-approval dialog, which rejects any embedded \r as a hidden
# control character. On Windows, core.autocrlf=true silently reintroduces
# CRLF into these files on checkout, breaking Workflow invocation with a
# "script contains control characters" error. Force LF so the checked-out
# bytes never contain \r, on any platform.
.claude/workflows/*.js text eol=lf

# SQLite databases (the committed src/reference/reference.db) are binary: no
# EOL conversion, no textual diff or merge.
*.db binary
